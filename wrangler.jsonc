{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pareto",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pareto-catalog",
      "database_id": "pareto-catalog-db",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FRONTIER",
      "id": "pareto-frontier-kv"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}