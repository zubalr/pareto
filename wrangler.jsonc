{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pareto",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pareto-catalog",
      "database_id": "cf4eae17-f102-480d-9fe5-e5c281fd3198",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FRONTIER",
      "id": "350de0bd422c42b595873959266dfdd4"
    }
  ],
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 2000
  },
  "triggers": {
    "crons": [
      "0 6 * * *"
    ]
  },
  "upload_source_maps": true
}