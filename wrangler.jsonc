{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pareto",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pareto-catalog",
      "database_id": "42a63de4-5c7f-4c93-843e-89f43b9f58cd",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FRONTIER",
      "id": "f347c405b07a4b62b67320d55143e74b"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}